#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ -x "$ROOT/Scripts/gstack-review-gate.sh" ]]; then
  "$ROOT/Scripts/gstack-review-gate.sh"
elif [[ -x "$ROOT/scripts/gstack-review-gate.sh" ]]; then
  "$ROOT/scripts/gstack-review-gate.sh"
else
  echo "error: gstack-review-gate.sh not found under Scripts/ or scripts/" >&2
  exit 1
fi

